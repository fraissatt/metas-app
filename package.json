  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "node scripts/test-both-tz.mjs",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" prisma migrate deploy; fi && next build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
