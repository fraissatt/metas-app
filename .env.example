DATABASE_URL="postgresql://metas:metas@localhost:5433/metas_app"
# Long random string, e.g. `openssl rand -base64 32`
# Must exist before deploying (Vercel: all environments)
BETTER_AUTH_SECRET="troque-por-um-segredo-longo"
# Vercel: set for Production only; Preview derives the URL from the request
BETTER_AUTH_URL="http://localhost:3000"
# "true" keeps /funil public; anything else requires login
FUNNEL_PUBLIC="true"
# Daily reminder (web push). Generate the pair with `npx web-push generate-vapid-keys`.
# Without them the "Lembrete diário" option stays hidden.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@example.com"
# Vercel sends it to /api/cron/lembrete; any long random string
CRON_SECRET=""
